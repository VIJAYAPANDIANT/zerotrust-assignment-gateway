# ==============================================================================
# ZeroTrust Assignment Submission Gateway - Backend Environment (.env.example)
# ==============================================================================

# Server Network & Runtime Environment
PORT=5000
NODE_ENV=production

# CORS Allowed Client Origin(s)
# Primary frontend URL:
CLIENT_URL=https://gateway.yourdomain.edu
# Comma-separated list for multi-origin or staging/production environments:
ALLOWED_ORIGINS=https://gateway.yourdomain.edu,http://localhost:5173

# Cryptographic Token Signing Secret (Required in production)
# Must be a high-entropy string (min 32 characters, never commit real secrets)
JWT_SECRET=replace_with_a_cryptographically_secure_random_production_secret

# Supabase PostgreSQL Database Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage Integration (Private Bucket: assignments)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=assignments

# Cloudflare Access Edge Boundary (Optional / Production)
# Set to true in production behind Cloudflare Access to enforce Cf-Access headers
CLOUDFLARE_ACCESS_REQUIRED=false
CLOUDFLARE_TEAM_DOMAIN=your-team-name.cloudflareaccess.com
CLOUDFLARE_AUD_KEY=your-application-aud-tag

