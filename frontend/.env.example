# ==============================================================================
# ZeroTrust Assignment Gateway - Frontend Environment Configuration (.env.example)
# ==============================================================================

# API Gateway Endpoint
# For local development with Express running on port 5000:
VITE_API_BASE_URL=http://localhost:5000/api

# For production deployments (e.g. deployed on Vercel, Cloudflare Pages, Netlify, or AWS):
# Set this to the public URL of your deployed backend API Gateway:
# VITE_API_BASE_URL=https://api.gateway.yourdomain.edu/api
# Or leave unset to make same-origin requests using the relative '/api' path.
