# ==============================================================================
# ZeroTrust Assignment Gateway - Frontend Environment Configuration (.env.example)
# ==============================================================================

# API Gateway Endpoint
# For local development with Express running on port 5000:
# (Defaults to '/api' which Vite automatically proxies to http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000/api

# For Cloudflare Workers production deployment:
# Configure VITE_API_BASE_URL in Cloudflare Dashboard (Workers -> Settings -> Variables)
# pointing to your active Cloudflare Tunnel or backend domain:
# VITE_API_BASE_URL=https://your-cloudflare-tunnel-url.trycloudflare.com
# VITE_API_BASE_URL=https://api.gateway.yourdomain.edu/api
# If left unset, the frontend requests relative '/api' endpoints.
